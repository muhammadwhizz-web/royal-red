# Royal Red environment file.
# You normally do NOT write this by hand: install.sh creates it for you.
# Manual setup only: point DATABASE_URL at your SQLite file (absolute path).
DATABASE_URL="file:/absolute/path/to/your/royal-red.db"

# Optional: pin the master secret that encrypts stored provider API keys
# (16+ chars). If unset, a random secret is generated once and kept at
# db/.royal-red-secret with 0600 permissions. Leave it unset unless you
# know you need to move an installation between machines.
# ROYALRED_MASTER_SECRET=
