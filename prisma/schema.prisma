generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model RoyalRedSession {
  id        String         @id @default(cuid())
  title     String         @default("New session")
  mode      String         @default("build")
  pinned    Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  RoyalRedMessage[]
  artifacts RoyalRedArtifact[]

  @@map("AwonSession") // physical table name preserved across the Royal Red rebrand - zero data migration
}

model RoyalRedMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   RoyalRedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  meta      String?
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@map("AwonMessage")
}

model RoyalRedArtifact {
  id        String                @id @default(cuid())
  sessionId String
  session   RoyalRedSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  kind      String                @default("site")
  entry     String                @default("index.html")
  files     String
  score     Int?
  review    String?
  createdAt DateTime              @default(now())
  versions  RoyalRedArtifactVersion[]

  @@index([sessionId, createdAt])
  @@map("AwonArtifact")
}

// immutable snapshot of an artifact's files after every write; the diff view
// reads from this history instead of the mutable artifact row
model RoyalRedArtifactVersion {
  id         String       @id @default(cuid())
  artifactId String
  artifact   RoyalRedArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  version    Int
  files      String
  note       String?
  createdAt  DateTime     @default(now())

  @@unique([artifactId, version])
  @@index([artifactId, createdAt])
  @@map("AwonArtifactVersion")
}

model RoyalRedAccount {
  id        String   @id @default(cuid())
  username  String   @unique
  role      String   @default("user")
  note      String?
  createdAt DateTime @default(now())

  @@map("AwonAccount")
}

model RoyalRedAudit {
  id        String   @id @default(cuid())
  action    String
  detail    String?
  ok        Boolean  @default(true)
  // run attribution (Round 3 run-queue prep): which Box run produced this
  // row. Nullable — pre-run-queue rows and kernel-level rows have none. This
  // is what lets N concurrent runs share one audit log without ambiguity.
  runId     String?
  // sub-agent attribution (Round 4, Phase 5 slice 1): rows produced inside a
  // sub-agent run carry the sub-agent identity (`<role>:<runId>`) and the
  // parent run it was spawned by. Null on top-level rows — those are the
  // kernel's own actions, already attributed by runId. "No action is
  // unattributed": every sub-agent row names WHO did it and WHO sent it.
  subAgentId  String?
  parentRunId String?
  // Round 6 (agent employees): the named royal role behind the action, e.g.
  // "Supreme Planner" or "Royal Builder". Adds a human-readable layer on top
  // of subAgentId so the AGENTS panel and the audit log speak the same names.
  agentRole   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([runId])
  @@index([subAgentId])
  @@map("AwonAudit")
}

// constraint ledger (Phase 2.1): structured, testable requirements extracted
// from the user prompt BEFORE the build starts; every entry gets a stable id
// and is graded individually at verification time
model RoyalRedConstraint {
  id        String   @id @default(cuid())
  sessionId String
  cid       String // C1, C2, ... stable within the session
  category  String // feature | style | content | technical | exclusion
  text      String // the requirement in the user's words
  assertion String // the testable assertion the verifier grades
  weight    Int      @default(1) // 1 = normal, 2 = user emphasized ("must")
  source    String   @default("extracted") // extracted | manual
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@map("AwonConstraint")
}

// verification receipts (Phase 2): one row per verification run per kind.
// kind: ledger | critique | visual | benchmark | cms
// status: pass | fail | partial | error | unverified
// data: JSON report payload rendered by the console VERIFY tab
model RoyalRedVerification {
  id         String   @id @default(cuid())
  sessionId  String
  artifactId String?
  kind       String
  status     String
  score      Float? // honest 0-10 where applicable (never inflated: min of judges)
  data       String
  createdAt  DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([artifactId])
  @@map("AwonVerification")
}

// second-model provider config (Phase 2.2): a critique-only model endpoint the
// user brings. API keys are stored AES-256-GCM encrypted and are NEVER returned
// by any API (only a masked hint). purpose is always "critique" in Phase 2.
model RoyalRedProviderConfig {
  id        String   @id @default(cuid())
  provider  String // openai | anthropic | custom
  label     String
  baseUrl   String
  model     String
  apiKeyEnc String? // base64(iv + tag + ciphertext)
  keyHint   String? // masked, e.g. sk-...ab12
  purpose   String   @default("critique")
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("AwonProviderConfig")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 4 — Permitted PC Control. Every desktop/box action belongs to a Run,
// every mutation is journaled before it happens, every consent decision is a
// row that outlives the run, and an abort freezes everything mid-flight.
// ─────────────────────────────────────────────────────────────────────────────

// a desktop run: one user command that produced a dry-run plan and executed
// (or was aborted). status: running | done | aborted
model RoyalRedRun {
  id           String   @id @default(cuid())
  sessionId    String
  status       String   @default("running") // running | done | aborted
  tool         String // which primitive started the run (e.g. box_move batch)
  // Round 6: the roster role name behind the run ("Supreme Planner"), aligned
  // with RoyalRedAudit.agentRole. Null for runs that predate the roster.
  agentRole    String?
  planJson     String? // full dry-run plan snapshot at approval time
  planHash     String? // sha256 of the plan; execution must match or refuse
  actionsTotal Int      @default(0)
  actionsDone  Int      @default(0)
  startedAt    DateTime @default(now())
  endedAt      DateTime?
  abortReason  String?
  // Phase 5 slice 1 (Round 4): the sub-agent fields. A run is still a run —
  // sub-agents are NOT a new process concept, they are runs with a parent.
  // parentRunId persists the tree so the subtree walk is a DB query, never an
  // in-memory guess (ISOLATION spec Q4). depth 0 = user-initiated.
  parentRunId  String?
  role         String? // planner | builder | null (user-initiated runs)
  depth        Int      @default(0)

  @@index([sessionId, startedAt])
  @@index([parentRunId])
  @@map("AwonRun")
}

// a consent request. tier: 1 (read) | 2 (write/move batch) | 3 (destructive,
// per-action, never batchable). status: pending | approved | denied | expired
// | frozen (kill switch) | superseded (a newer decision replaced it)
model RoyalRedConsent {
  id         String    @id @default(cuid())
  sessionId  String
  runId      String?
  tier       Int
  title      String
  detail     String? // human-readable summary shown on the card
  payload    String? // JSON: the dry-run plan or op list being consented
  status     String    @default("pending")
  decision   String? // approve | deny | modify | rule
  ruleText   String? // for T3 override: the rule the user TYPED, verbatim
  scope      String? // rule scope: e.g. "move *.tmp -> .awon-trash"
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?
  expiresAt  DateTime // createdAt + 120s; expiry fails closed

  @@index([sessionId, status, createdAt])
  @@index([runId])
  @@map("AwonConsent")
}

// permanent consent rules. Only created by the user TYPING the rule verbatim
// in the consent card (no checkbox anywhere in the product). The kernel matches
// incoming ops against enabled rules; a match still logs an audit row.
model RoyalRedConsentRule {
  id        String   @id @default(cuid())
  sessionId String?
  ruleText  String // verbatim typed text, shown back to the user forever
  op        String // primitive name this rule covers (e.g. box_trash)
  pattern   String // glob-ish scope: "Downloads/*.tmp"
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([op, enabled])
  @@map("AwonConsentRule")
}

// write-ahead undo journal. EVERY mutating box op writes its inverse here
// BEFORE executing. Trash files live under the box .awon-trash/<runId>/ tree;
// nothing is ever unlinked by the agent - trash is the only "delete".
model RoyalRedUndoEntry {
  id        String   @id @default(cuid())
  runId     String
  sessionId String
  seq       Int // order within the run (replay is reverse)
  op        String // move | copy | trash | mkdir | write
  fromPath  String // box-virtual path the content came from
  toPath    String // box-virtual path the content went to
  trashPath String? // real path inside .awon-trash when op=trash
  undone    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([runId, seq])
  @@index([sessionId, createdAt])
  @@map("AwonUndoEntry")
}

// ROYAL RED cost ledger (router): one row per provider call attempt.
// Append-only. Powers the ROUTER panel + "what did this cost me" surfaces.
model RoyalRedCostEntry {
  id        String   @id @default(cuid())
  operation String
  modality  String
  providerId String
  model     String
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  costUsd   Float    @default(0)
  latencyMs Int      @default(0)
  outcome   String   // ok | error | switched | dry-run
  error     String?
  attempt   Int      @default(1)
  // Round 4: which run spent this. The PHASE5-BUDGET ledger discipline
  // requires receipts reconstructible per run; nullable for kernel rows that
  // predate run attribution (and for non-run surfaces like panel probes).
  runId     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([providerId])
  @@index([runId])
  @@map("AwonCostEntry")
}

// ROYAL RED memory store (Round 6, Section 2). Persistent, scoped memory that
// survives sessions and projects. User writes are trusted; agent-inferred
// writes are proposals until approved (source=user vs source=agent with
// confidence < 1). Memories never leave the machine: no cloud sync path exists.
model RoyalRedMemory {
  id         String    @id @default(cuid())
  scope      String    @default("global") // global | project | session | agent
  // empty string = no specific reference (global scope). Non-nullable on
  // purpose: SQLite treats NULLs as distinct in unique indexes, which would
  // break the (scope, scopeRef, key) dedupe the write path relies on.
  scopeRef   String    @default("")
  key        String    // short searchable name, e.g. "theme preference"
  value      String    // the memory itself, plain English
  source     String    @default("user") // user | agent | inferred
  confidence Float     @default(1) // 0..1; agent inferences start lower
  tags       String?   // comma-separated lowercase tags
  expiresAt  DateTime? // null = never expires
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([scope, scopeRef, key])
  @@index([scope, updatedAt])
  @@map("AwonMemory")
}

// ROYAL RED session event log (DeepSeek-harness port #1, MIT pattern).
// The append-only, typed, replayable source of truth for agent sessions:
// rows are only ever INSERTED (no update path exists in code), seq is
// per-session monotonic, and unknown future event types replay as ignorable.
model RoyalRedEventLog {
  id        String   @id @default(cuid())
  sessionId String
  runId     String?
  seq       Int // per-session monotonic, contiguous 1..N
  type      String // typed vocabulary, see server/royal-red/event-log.ts
  ignorable Boolean @default(false) // forward-compat: newer-kernel events are skipped on replay, never misread
  payload   String // JSON
  createdAt DateTime @default(now())

  @@unique([sessionId, seq])
  @@index([sessionId, createdAt])
  @@index([type])
  @@map("AwonEventLog")
}
